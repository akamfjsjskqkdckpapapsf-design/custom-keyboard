<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.example.ime.latin">
    <uses-permission android:name="android.permission.BIND_INPUT_METHOD" />
    <application android:allowBackup="true" android:label="CustomKeyboard">
        <service android:name=".CustomKeyboardService" android:label="Custom Keyboard IME" android:permission="android.permission.BIND_INPUT_METHOD" android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>
    </application>
</manifest>
