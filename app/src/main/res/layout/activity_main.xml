<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="إعدادات التسطير والنصوص الطويلة"
            android:textColor="#00E676"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnImportTxt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="استيراد ملف نصي (.txt)"
            android:backgroundTint="#29B6F6"
            android:textColor="#000000"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/etLongText"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="#1E1E1E"
            android:textColor="#FFFFFF"
            android:hint="أو ألصق النص الطويل هنا..."
            android:textColorHint="#777777"
            android:gravity="top|start"
            android:padding="10dp"
            android:layout_marginTop="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="عدد الكلمات في كل سطر:"
            android:textColor="#FFFFFF"
            android:layout_marginTop="14dp" />

        <EditText
            android:id="@+id/etWordsPerLine"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#1E1E1E"
            android:textColor="#FFFFFF"
            android:inputType="number"
            android:text="6"
            android:padding="8dp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvSpeedLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="سرعة الكتابة: 50ms"
            android:textColor="#FFFFFF"
            android:layout_marginTop="14dp" />

        <SeekBar
            android:id="@+id/sbSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:min="10"
            android:max="200"
            android:progress="50"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/btnSaveAll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="حفظ الإعدادات بالنظام التسلسلي"
            android:backgroundTint="#00E676"
            android:textColor="#000000"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
