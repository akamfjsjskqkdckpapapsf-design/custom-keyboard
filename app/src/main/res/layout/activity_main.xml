<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="إعدادات التسطير والتلقائي"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp" />

        <!-- 1. رمز التشغيل الإجباري -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="رمز التشغيل الإجباري (مثلاً: # أو 1):"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etTriggerSymbol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#222222"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:hint="اكتب رمز أو كلمة التشغيل هنا..."
            android:textColorHint="#777777"
            android:layout_marginBottom="16dp" />

        <!-- السطور والكليشة -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="اكتب الكليشة / السطور هنا:"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etAutoText"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="#222222"
            android:textColor="#FFFFFF"
            android:gravity="top|start"
            android:padding="12dp"
            android:hint="اكتب النص أو السطور هنا..."
            android:textColorHint="#777777"
            android:layout_marginBottom="16dp" />

        <!-- سرعة الكتابة -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="سرعة الكتابة (من 1 إلى 200):"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#222222"
            android:textColor="#FFFFFF"
            android:inputType="number"
            android:text="50"
            android:padding="12dp"
            android:layout_marginBottom="20dp" />

        <!-- 2. خيارات الأوتو -->
        <CheckBox
            android:id="@+id/cbEnableAuto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تفعيل الأوتو (بدء التشغيل تلقائياً)"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:buttonTint="#2196F3"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:layout_marginBottom="16dp">

            <CheckBox
                android:id="@+id/cbReplaceSpaceInAuto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="إضافة فاصلة (~) بعد كل كلمة مع التسطير"
                android:textColor="#AAAAAA"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ضع المنشن أو الاسم الذي ينكتب بعد كل سطر (اختياري):"
                android:textColor="#CCCCCC"
                android:textSize="13sp"
                android:layout_marginTop="8dp" />

            <EditText
                android:id="@+id/etSuffixText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#222222"
                android:textColor="#FFFFFF"
                android:padding="10dp"
                android:hint="مثال: @__819 أو يا حمد"
                android:textColorHint="#777777" />
        </LinearLayout>

        <!-- 3. تبديل المسافة بـ ~ للكتابة العادية -->
        <CheckBox
            android:id="@+id/cbReplaceSpaceGlobal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تبديل المسافة إلى فاصلة (~) في جميع محادثات الكيبورد"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:buttonTint="#2196F3"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="حفظ الإعدادات"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
