<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الزخرفة (الحقن التلقائي)"
            android:textColor="#00E676"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/swEnableDecoration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تفعيل الزخرفة"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/etDecorationSymbol"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#222222"
            android:textColor="#FFFFFF"
            android:hint="رمز الاستبدال (مثلاً ~)"
            android:textColorHint="#888888"
            android:padding="8dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="المظهر والأداء"
            android:textColor="#00E676"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <Spinner
            android:id="@+id/spTheme"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#222222"
            android:layout_marginTop="8dp" />

        <Spinner
            android:id="@+id/spFontSize"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#222222"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvSpeedValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="السرعة: 50ms"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp" />

        <SeekBar
            android:id="@+id/sbSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:min="5"
            android:max="150"
            android:progress="50"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="عدد كلمات التسطير:"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/etWordCount"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#222222"
            android:textColor="#FFFFFF"
            android:inputType="number"
            android:text="6"
            android:padding="8dp"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/btnSaveConfig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="حفظ الإعدادات"
            android:backgroundTint="#00E676"
            android:textColor="#000000"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="إدارة القوائم والكلايش"
            android:textColor="#00E676"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <EditText
            android:id="@+id/etNewCliché"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="#222222"
            android:textColor="#FFFFFF"
            android:hint="أضف كليشة جديدة هنا..."
            android:textColorHint="#888888"
            android:gravity="top|start"
            android:padding="8dp"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnAddCliché"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="إضافة"
                android:backgroundTint="#424242"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnShowClichés"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="عرض الكلايش"
                android:backgroundTint="#424242"
                android:textColor="#FFFFFF"
                android:layout_marginStart="8dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
